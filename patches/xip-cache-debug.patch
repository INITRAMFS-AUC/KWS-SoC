diff --git a/kws_soc_vpi.cpp b/kws_soc_vpi.cpp
index 027a4d4..f4d6d53 100644
--- a/kws_soc_vpi.cpp
+++ b/kws_soc_vpi.cpp
@@ -811,6 +811,18 @@ int main(int argc, char **argv) {
     // -----------------------------------------------------------------------
     // Teardown
     // -----------------------------------------------------------------------
+    // XIP cache stats — dump before final() so they show next to the
+    // firmware's CYCLES_INFER / IRQS lines in the run log.  These come
+    // from counters inside ro_dmc; see peris/xip/ro_cache.v.
+    {
+        uint32_t hits   = top->dbg_xip_cache_hits;
+        uint32_t misses = top->dbg_xip_cache_misses;
+        uint32_t total  = hits + misses;
+        double miss_rate = total ? (100.0 * misses) / total : 0.0;
+        printf("XIP_CACHE_HITS:%u\n",   hits);
+        printf("XIP_CACHE_MISSES:%u\n", misses);
+        printf("XIP_CACHE_MISS_RATE:%.2f%%\n", miss_rate);
+    }
     fflush(stdout);
     top->final();
 

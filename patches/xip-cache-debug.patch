diff --git a/peris/xip/ro_cache.v b/peris/xip/ro_cache.v
index 27af26d..0e60631 100644
--- a/peris/xip/ro_cache.v
+++ b/peris/xip/ro_cache.v
@@ -16,7 +16,15 @@ module ro_dmc #(parameter LW=32*16, NL=64) (
     input  wire [LW-1:0]    m_data,
     output wire [31:0]      m_addr,
     output wire             m_start,
-    input  wire             m_done
+    input  wire             m_done,
+
+    // Debug counters — incremented on every CPU read transaction so the
+    // VPI testbench can compute the cache hit rate at end of run.  Wraps
+    // at 2^32 (~4G transactions); inference is well under that.  Free in
+    // sim, ~64 flops on FPGA — keep them so an FPGA build can also probe
+    // the cache via a future debug register.
+    output reg [31:0]       dbg_hits,
+    output reg [31:0]       dbg_misses
 );
 
     localparam      LWB = LW/8;
@@ -97,6 +105,20 @@ module ro_dmc #(parameter LW=32*16, NL=64) (
     assign m_start  = m_start_reg; // Driven by flip-flop now
     assign m_addr   = miss_addr_reg;
 
+    // Hit / miss counters — sample on the address phase (cpu_rd is a
+    // 1-cycle pulse per AHB read transaction, so each transaction is
+    // counted exactly once).  Bus stalls during a fetch hold cpu_rd
+    // low so we never double-count.
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            dbg_hits   <= 32'b0;
+            dbg_misses <= 32'b0;
+        end else if (cpu_rd) begin
+            if (ahit) dbg_hits   <= dbg_hits   + 1'b1;
+            else      dbg_misses <= dbg_misses + 1'b1;
+        end
+    end
+
     // --- Read Logic ---
     localparam NW = LW/32;
     wire [31:0] words [NW-1:0];

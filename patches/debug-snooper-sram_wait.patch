+	// every read transaction. Used to make Verilator simulate the extra
+	// d-port read latency we suspect the Cyclone V M10K has on the FPGA
+	// build (see docs/2port_dport_bridge_bug.md). 0 = upstream behaviour.
+	parameter EXTRA_RD_WAIT = 0,

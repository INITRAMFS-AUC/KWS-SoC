@@ -141,7 +146,29 @@ sram_sync #(
 
 
 assign ahbls_hresp = 1'b0;
-assign ahbls_hready_resp = !read_delay_state;
+
+// KWS-SoC: optional 1-cycle read wait state. Pulses high for one cycle
+// after every read aphase, so:
+//   T   : ahb_read_aphase=1, hready_resp=1 (slave samples).
+//   T+1 : rd_wait_state=1, hready_resp=0 (master holds).
+//   T+2 : rd_wait_state=0, hready_resp=1 (master samples rdata).
+// Master holds aphase signals during T+1, so sram_sync's already-latched
+// rdata (= mem[addr_T] from posedge T+1) is presented at T+2.
+reg rd_wait_state;
+generate if (EXTRA_RD_WAIT) begin: g_extra_rd_wait
+	always @(posedge clk or negedge rst_n) begin
+		if (!rst_n)
+			rd_wait_state <= 1'b0;
+		else if (ahb_read_aphase && !rd_wait_state)
+			rd_wait_state <= 1'b1;
+		else
+			rd_wait_state <= 1'b0;
+	end
+end else begin: g_no_extra_rd_wait
+	always @(*) rd_wait_state = 1'b0;
+end endgenerate
+
+assign ahbls_hready_resp = !read_delay_state && !rd_wait_state;
 

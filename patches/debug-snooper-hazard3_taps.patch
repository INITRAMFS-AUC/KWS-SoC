diff --git a/hdl/hazard3_core.v b/hdl/hazard3_core.v
index 84b748b..6698337 100644
--- a/hdl/hazard3_core.v
+++ b/hdl/hazard3_core.v
@@ -86,7 +86,19 @@ module hazard3_core #(
 	// Level-sensitive interrupt sources
 	input  wire [NUM_IRQS-1:0] irq,       // -> mip.meip
 	input  wire                soft_irq,  // -> mip.msip
-	input  wire                timer_irq  // -> mip.mtip
+	input  wire                timer_irq, // -> mip.mtip
+
+	// KWS-SoC debug taps for the bus snooper (M-stage forwarding observability).
+	output wire [4:0]          dbg_xm_rs2,
+	output wire [4:0]          dbg_mw_rd,
+	output wire [W_DATA-1:0]   dbg_xm_result,
+	output wire [W_DATA-1:0]   dbg_mw_result,
+	output wire [W_DATA-1:0]   dbg_m_wdata,
+
+	// More taps to chase the early-aphase pipelining hypothesis.
+	output wire                dbg_bus_aph_req_d,
+	output wire [4:0]          dbg_xm_memop,
+	output wire                dbg_m_bus_stall
 );
 
 `include "hazard3_ops.vh"
@@ -1579,6 +1591,19 @@ hazard3_regfile_1w2r #(
 	.wen    (m_reg_wen)
 );
 
+// KWS-SoC debug taps. xm_rs2/mw_rd are 5-bit register addresses; xm_result is the
+// ALU result driving store data when no forwarding hits; mw_result is the loaded
+// value forwarded into m_wdata when xm_rs2 == mw_rd; m_wdata is the chosen one.
+assign dbg_xm_rs2    = xm_rs2;
+assign dbg_mw_rd     = mw_rd;
+assign dbg_xm_result = xm_result;
+assign dbg_mw_result = mw_result;
+assign dbg_m_wdata   = m_wdata;
+
+assign dbg_bus_aph_req_d = bus_aph_req_d;
+assign dbg_xm_memop      = xm_memop;
+assign dbg_m_bus_stall   = m_bus_stall;
+
 `ifdef RISCV_FORMAL
 `include "hazard3_rvfi_monitor.vh"
 `endif

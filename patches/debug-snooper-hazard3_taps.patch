+	.dbg_xm_rs2                 (dbg_xm_rs2),
+	.dbg_mw_rd                  (dbg_mw_rd),
+	.dbg_xm_result              (dbg_xm_result),
+	.dbg_mw_result              (dbg_mw_result),
+	.dbg_m_wdata                (dbg_m_wdata),
+	.dbg_bus_aph_req_d          (dbg_bus_aph_req_d),
+	.dbg_xm_memop               (dbg_xm_memop),
+	.dbg_m_bus_stall            (dbg_m_bus_stall)
 );
 

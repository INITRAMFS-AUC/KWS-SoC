# --- Magic Words (Easy to spot in waveforms) ---
DEADBEEF
CAFEBABE
0BADF00D
FACEFEED

# --- Walking '1' (Good for checking bit alignment) ---
80000000
40000000
20000000
10000000
08000000
04000000
02000000
01000000

# --- Walking '0' ---
7FFFFFFF
BFFFFFFF
DFFFFFFF
EFFFFFFF

# --- Counting Sequence (Good for checking dropped frames) ---
00000001
00000002
00000003
00000004
00000005
00000006
00000007
00000008

# --- Alternating Bits ---
AAAAAAAA
55555555
